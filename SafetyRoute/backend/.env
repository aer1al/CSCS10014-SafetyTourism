# --- CẤU HÌNH KẾT NỐI OLLAMA ---
OLLAMA_HOST=http://localhost:11434

# --- CHỌN MODEL (Dùng model nhẹ để tránh lỗi 500/CUDA) ---
# Bạn hãy dùng 1 trong 2 dòng dưới đây (nhớ bỏ dấu # ở đầu dòng muốn chọn):

OLLAMA_MODEL=gemma3:4b

# (Nếu máy mạnh RAM > 16GB + Card xịn thì mới dùng dòng dưới)
# OLLAMA_MODEL=llama3
